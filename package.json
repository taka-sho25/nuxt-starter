{
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "cross-env NODE_ENV=development APP_STAGE=development nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxi start",
    "lint": "eslint .",
    "fix": "eslint --fix .",
    "lint:style": "stylelint \"**/*.{vue,css}\" --ignore-path .gitignore",
    "prettier": "prettier --write '**/*.{js,ts,vue,json,css}'",
    "test": "vitest",
    "test:update": "vitest -u",
    "e2e": "npx playwright test",
    "playwright:install": "npx playwright install --with-deps",
    "playwright:ci": "SHARD=\"$((${CIRCLE_NODE_INDEX}+1))\"; npx playwright test --shard=${SHARD}/${CIRCLE_NODE_TOTAL}",
    "playwright": "npx playwright test",
    "storybook": "cross-env APP_STAGE=development storybook dev --port 6006",
    "api:build": "aspida && aspida-mock",
    "prism": "prism mock ./__mock__/mock.yaml -p 3507 -h localhost",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint .",
      "prettier --write '**/*.{js,ts}'"
    ],
    "*.vue": [
      "eslint .",
      "stylelint **/*.vue",
      "prettier --write **/*.vue"
    ],
    "*.css": "stylelint **/*.css"
  },
  "dependencies": {
    "@aspida/fetch": "^1.14.0",
    "@nuxt/eslint": "^1.12.1",
    "@nuxt/icon": "^2.2.0",
    "@vee-validate/zod": "^4.15.1",
    "aspida": "^1.14.0",
    "aspida-mock": "^0.11.1",
    "dayjs": "^1.11.19",
    "nuxt": "^4.2.2",
    "typescript": "^5.9.3",
    "vee-validate": "^4.13.1",
    "vue-router": "^4.5.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.0.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^3.23.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/storybook": "^9.0.1",
    "@playwright/test": "^1.57.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.1.11",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.0.9",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "happy-dom": "^20.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.0",
    "storybook": "^10.1.11",
    "stylelint": "^17.0.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.2.2"
  }
}
